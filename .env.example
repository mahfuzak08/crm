APP_NAME="Lake View Iconic Tower CRM"
APP_ENV=production
APP_DEBUG=false
# Full URL where the app is reachable, no trailing slash
APP_URL=http://localhost/crm
APP_TIMEZONE=Asia/Dhaka
# Random 64-hex secret used to sign share links (installer generates it)
APP_KEY=
FORCE_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lake_view_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=lakecrm
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Which identifiers may be used to sign in (comma separated: email,username,phone)
LOGIN_FIELDS=email,username,phone

UPLOAD_MAX_MB=10

# Mail: none | mail | smtp
MAIL_DRIVER=none
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME="Lake View Iconic Tower CRM"
